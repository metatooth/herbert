{
  "name": "herbert",
  "version": "0.41.0",
  "description": "automate your horticulture",
  "engines": {
    "node": "20.18.1",
    "npm": "10.8.2"
  },
  "scripts": {
    "test": "NODE_ENV=unit_test WSS_URL=ws://localhost:5000 jest",
    "clean": "rm -rf dist",
    "dev": "vite src/client",
    "build": "run-p build:client build:server build:socket-server build:worker",
    "preview": "vite preview src/client",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/",
    "serve": "run-p serve:client serve:server serve:socket-server serve:worker",
    "serve:client": "npm run dev",
    "serve:server": "tsc-watch --noClear -b ./src/server/tsconfig.json --onSuccess \"node --enable-source-maps dist/server/main.js\"",
    "serve:socket-server": "tsc-watch --noClear -b ./src/socket-server/tsconfig.json --onSuccess \"node --enable-source-maps dist/socket-server/main.js\"",
    "serve:worker": "tsc-watch --noClear -b ./src/worker/tsconfig.json --onSuccess \"node --enable-source-maps dist/worker/main.js\"",
    "copy:favicon": "cp src/server/favicon.ico dist/server/",
    "build:client": "run-p type-check:client \"build-only:client {@}\" --",
    "build-only:client": "vite build src/client",
    "type-check:client": "vue-tsc --build src/client",
    "build:server": "tsc -b src/server && npm run copy:favicon",
    "build:socket-server": "tsc -b src/socket-server",
    "build:worker": "tsc -b src/worker"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metatooth/herbert.git"
  },
  "license": "MIT",
  "author": "Terry Lorber",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.34",
    "@fortawesome/free-solid-svg-icons": "^5.15.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@types/node": "^22.10.5",
    "axios": "^1.7.9",
    "body-parser": "^1.19.0",
    "bulma": "^0.9.2",
    "chart.js": "^2.9.4",
    "chartjs-adapter-date-fns": "^1.0.0",
    "config": "^3.3.3",
    "cors": "^2.8.5",
    "date-fns": "^2.17.0",
    "date-fns-timezone": "^0.1.4",
    "date-fns-tz": "^1.1.3",
    "express": "^4.17.1",
    "express-promise-router": "^4.0.1",
    "globals": "^15.14.0",
    "meross-cloud": "^3.1.2",
    "noble": "^1.9.1",
    "node-switchbot": "^3.4.3",
    "onoff": "^6.0.1",
    "pg": "^8.5.1",
    "sass": "^1.83.0",
    "serve-favicon": "^2.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.8.1",
    "vue": "^3.5.13",
    "vue-cookies": "^1.7.4",
    "vue-resize-directive": "^1.2.0",
    "vue-router": "^3.5.1",
    "vuex": "^4.1.0",
    "ws": "^7.4.3"
  },
  "devDependencies": {
    "@types/config": "0.0.38",
    "@types/cors": "^2.8.5",
    "@types/jest": "^27.0.0",
    "@types/pg": "^8.5.1",
    "@types/serve-favicon": "^2.5.2",
    "@types/ws": "^7.4.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "jest": "^29.2.5",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.2.5",
    "tsc-watch": "^4.4.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
